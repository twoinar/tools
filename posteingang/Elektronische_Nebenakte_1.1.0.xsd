<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" xmlns:elna="http://www.bnotk.de/schemas/elektronische_nebenakte" targetNamespace="http://www.bnotk.de/schemas/elektronische_nebenakte">

    <!-- Elementen für die Erstellung von Beispieldatensätzen -->

    <xs:element name="Nebenakte_nur_mit_Pflichfeldern" type="elna:Nebenakte"/>
    <xs:element name="Nebenakte_mit_allen_Datenfeldern" type="elna:Nebenakte"/>

    <!-- Typdefinitionen -->

    <xs:complexType name="Nebenakte">
        <xs:annotation>
            <xs:documentation>
                Das Hauptelement einer Nebenakte einer Amtstätigkeit.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Aktenzeichen">
                <xs:annotation>
                    <xs:documentation>
                        Das Aktenzeichen der Nebenakte im eigenen Format des Notarbüros.
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="32"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="Beschreibung" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        Eine freie Beschreibung der Nebenakte. 
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="255"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element minOccurs="0" name="Amtstraeger_Origin" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Der Name der ursprünglichen Amtstätigkeit, welche die Nebenakte errichtet hat. 
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="unbounded" minOccurs="0" name="Verwandte_Aktenzeichen">
                <xs:annotation>
                    <xs:documentation>
                        Verweis auf andenen thematisch verwandten Nebenakten.
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="32"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element maxOccurs="unbounded" minOccurs="0" name="Dokument"
                type="elna:Dokument_Sonstiges">
                <xs:annotation>
                    <xs:documentation>
                        Dokumente, die dieser Nebenakte zugehörig sind, aber nicht eine notarielle Urkunde sind.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="unbounded" name="Vorgang" type="elna:Vorgang">
                <xs:annotation>
                    <xs:documentation>
                        Eine Liste der dieser Nebenakte zugehörigen Vorgänge. 
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Anlagedatum" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Das Datum der Anlage der Nebenakte.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="Schema_Version" fixed="1.1.0" use="required" type="xs:string">
            <xs:annotation>
                <xs:documentation>
                    Ein technisches Attribut, um die Version des XML-Schemas zu bezeichnen, der dieses Nebenakte XML-Dokument entspricht.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Exportiert_am" use="optional" type="xs:dateTime">
            <xs:annotation>
                <xs:documentation>
                    Der Erstellungszeitpunkt des Nebenakte XML-Dokumentes.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Exportiert_von" use="optional" type="xs:string">
            <xs:annotation>
                <xs:documentation>
                    Der Nutzer, der dieses XML-Dokument erstellt bzw. exportiert hat.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Exportiert_aus" use="optional" type="xs:string">
            <xs:annotation>
                <xs:documentation>
                    Der Name der Notarsoftware, die dieses Nebenakte XML-Dokument erzeugt hat. 
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="Vorgang">
        <xs:annotation>
            <xs:documentation>
                Beschreibt einen der Nebenakte zugehörigen Vorgang. 
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Vorgangszeichen">
                <xs:annotation>
                    <xs:documentation>
                        Das Zeichen des Vorgangs.
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="32"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element minOccurs="0" name="Beschreibung">
                <xs:annotation>
                    <xs:documentation>
                        Eine freie Beschreibung des Vorgangs. 
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="255"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:choice minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        Ein Verweis auf eine Verwahrungsmasse im Massenbuch oder im VVZ.
                    </xs:documentation>
                </xs:annotation>
                <xs:element maxOccurs="unbounded" minOccurs="1" name="Nr_Massenbuch">
                    <xs:annotation>
                        <xs:documentation>
                            Ein Verweis auf eine verwahrungsmasse im Massenbuch.
                        </xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:maxLength value="16"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:element>
                <xs:element maxOccurs="unbounded" minOccurs="1" name="Massennummer">
                    <xs:annotation>
                        <xs:documentation>
                            Ein Verweis auf eine Verwahrungsmasse im VVZ.
                        </xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:maxLength value="16"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:element>
            </xs:choice>
            <xs:element minOccurs="0" name="Abschluss_Amtsgeschaeft" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Das Datum des Abschlusses des Amtsgeschäftes.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Aufbewahrungsfrist">
                <xs:annotation>
                    <xs:documentation>
                        Die Aufbewahrungsfrist in Jahren.
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:integer">
                        <xs:minInclusive value="7"/>
                        <xs:maxInclusive value="30"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element minOccurs="0" name="Weitere_Aufbewahrung">
                <xs:annotation>
                    <xs:documentation>
                        Abbildung eines Sachverhalts, der die weitere Aufbewahrung nach Ablauf der Aufbewahrungsfrist gebietet.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Angeordnet_am" type="xs:date">
                            <xs:annotation>
                                <xs:documentation>
                                    ...
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="Angeordnet_bis" type="xs:date">
                            <xs:annotation>
                                <xs:documentation>
                                    ...
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="Angeordnet_weil" type="xs:string">
                            <xs:annotation>
                                <xs:documentation>
                                    Grund der Aufbewahrung nach Ablauf der Aufbewahrungsfrist
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element minOccurs="0" name="Sachbearbeiter" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Der Sachbearbeiter, der den Vorgang bearbeitet.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="unbounded" minOccurs="0" name="Urkunde" type="elna:Urkunde">
                <xs:annotation>
                    <xs:documentation>
                        Eine Liste der zum Vorgang gehördenden notariellen Urkunden.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="Beteiligte" type="elna:Beteiligte">
                <xs:annotation>
                    <xs:documentation>
                        Eine Liste der zum Vorgang gehörenden Beteiligten.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="unbounded" minOccurs="0" name="Dokument"
                type="elna:Dokument_Sonstiges">
                <xs:annotation>
                    <xs:documentation>
                        Eine Liste der zum Vorgang gehörenden Dokumente (soweit diese nicht Teil einer notariellen Urkunde sind).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="unbounded" minOccurs="0" name="Geschaeftsgegenstand"
                type="elna:Geschaeftsgegenstand_Vorgang">
                <xs:annotation>
                    <xs:documentation>
                        Der Geschäftsgegenstand des Vorgangs aus der Werteliste.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Zusatz_zum_Geschaeftsgegenstand" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Ein frei bezeichneter abweichender Geschäftsgegenstand des Vorgangs. 
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Anlagedatum" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Das Datum, an dem der Vorgang angelegt wurde.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Urkunde">
        <xs:annotation>
            <xs:documentation>
                Beschreibt eine notarielle Urkunde, die zu einem Vorgang gehört.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:choice minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        Die eindeutige Bezeichnung der Urkunde.
                    </xs:documentation>
                </xs:annotation>
                <xs:element name="UR_Nr" type="xs:string">
                    <xs:annotation>
                        <xs:documentation>
                            Die Urkundenrollennummer einer Urkunde vor Einführung von UVZ.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="UVZ_Nr" type="elna:Uvz_Nummer">
                    <xs:annotation>
                        <xs:documentation>
                            Die UVZ-Nummer einer Urkunde nach Einführung von UVZ.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
            <xs:element minOccurs="0" name="Amtstraeger_Origin" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Der Name der ursprunglichen Amtstätigkeit, die diese Urkunde erstellt hat. Z.B. "Notar Max Mustermann in Musterstadt"
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Beurkundungsdatum" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Datum der Beurkundung.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Urkundsperson" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Der beurkundende Notar oder Notariatsverwalter bzw. sein Vertreter.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Ort_der_Beurkundung" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Die Anschrift des Orts der Beurkundung. Wenn die Beurkundung in der Geschäftsstelle (d.h. im Notarbüro) stattfindet, kann hier einfach "Geschäftsstelle" angegeben werden.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Geschaeftsgegenstand" type="elna:Geschaeftsgegenstand_Urkunde">
                <xs:annotation>
                    <xs:documentation>
                        Der Geschäftsgegenstand der Urkunde aus der Werteliste.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Zusatz_zum_Geschaeftsgegenstand" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Ein frei definierbarer abweichender Geschäftsgegenstand der Urkunde.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Notariell_verwahrter_Erbvertrag" default="false"
                type="xs:boolean">
                <xs:annotation>
                    <xs:documentation>
                        Ein Flag, ob der Erbvertrag im Notarbüro verwahrt wird.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Videokommunikation" default="false" type="xs:boolean">
                <xs:annotation>
                    <xs:documentation>
                        Ein Flag, ob die Beurkundung online per Videokommunikation erfolgt ist.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Streng_Vertraulich" default="false" type="xs:boolean">
                <xs:annotation>
                    <xs:documentation>
                        Ein Flag, ob die Urkunde streng vertraulich ist.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="unbounded" name="Dokument" type="elna:Dokument_Urkunde">
                <xs:annotation>
                    <xs:documentation>
                        Eine Liste der zur Urkunde zugehörigen Dokumente.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="Registrierung">
                <xs:annotation>
                    <xs:documentation>
                        Eine Registrierung oder Anzeige in Zusammenhang mit der Urkunde. 
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Registrierung_Typ" type="elna:Registrierung_Typ">
                            <xs:annotation>
                                <xs:documentation>
                                    Der Typ der Registrierung aus der Werteliste.
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element minOccurs="0" name="Registrierungsnummer" type="xs:string">
                            <xs:annotation>
                                <xs:documentation>
                                    Die eindeutige Nummer der Registrierung.
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element minOccurs="0" name="Datum" type="xs:date">
                            <xs:annotation>
                                <xs:documentation>
                                    Das Datum der Registrierung. 
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element minOccurs="0" name="Finanzamt" type="xs:string">
                            <xs:annotation>
                                <xs:documentation>
                                    Bezeichnung des Finanzamtes.
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element minOccurs="0" name="Finanzamtsdienststelle"
                            type="elna:Finanzamtsdienststelle">
                            <xs:annotation>
                                <xs:documentation>
                                    Die Steuerbehörde zu einem passenden Registrierungstyp.
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="Verbindung"
                type="elna:Urkunden_Verbindung">
                <xs:annotation>
                    <xs:documentation>
                        Eine Liste von Verbindungen zwischen dieser und anderen Urkunden.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Dokument_Urkunde">
        <xs:annotation>
            <xs:documentation>
                Beschreibt ein urkundsbezogenes Dokument.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element minOccurs="0" name="Hauptdokument" type="xs:boolean">
                <xs:annotation>
                    <xs:documentation>
                        Flag, ob das Dokument das Hauptdokument der Urkunde ist.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Dokument_Art" type="elna:Dokument_Art">
                <xs:annotation>
                    <xs:documentation>
                        Die Art des Dokumentes aus der Werteliste.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="unbounded" minOccurs="0" name="Kategorie" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Die Kategorie des Dokumentes. 
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Archiviert_In_USL" type="xs:boolean" fixed="true">
                <xs:annotation>
                    <xs:documentation>
                        Das Dokument wird in USL gespeichert und nicht im Filesystem über die Nebenakte referenziert.  
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="USL_Referenz" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Die eindeutige AOID des Dokumentes in USL.  
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="Dokument_Info" type="elna:Dokument_Info">
                <xs:annotation>
                    <xs:documentation>
                        Die Informationen zu den eigentlichen Dateien des Dokumentes und der dazu gehörigen Signaturen.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>



            <xs:element maxOccurs="1" minOccurs="0" name="Betreff_Bezeichnung" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Eine freie Bezeichnung des Dokumentes. 
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="Eingangsdatum" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Das Eingangsdatum des Dokumentes.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="Dokumentendatum" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Das Erstellungsdatum des Dokumentes.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="Version" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Die Version des Dokumentes.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="Letzte_Aenderung" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Letztes Änderungsdatum des Dokumentes.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="Zuletzt_bearbeitet_durch" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Name / Username des Nutzers, der das Dokument zuletzt bearbeitet hat.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Dokument_Sonstiges">
        <xs:annotation>
            <xs:documentation>
                Beschreibt ein nicht urkundsbezogenes Dokument.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element maxOccurs="unbounded" minOccurs="0" name="Kategorie" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Die Kategorie des Dokumentes. 
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="1" name="Dokument_Info" type="elna:Dokument_Info">
                <xs:annotation>
                    <xs:documentation>
                        Die Informationen zu den eigentlichen Dateien des Dokumentes und der dazu gehörigen Signaturen.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="Betreff_Bezeichnung" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Eine freie Bezeichnung des Dokumentes. 
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="Eingangsdatum" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Das Eingangsdatum des Dokumentes.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="Dokumentendatum" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Das Erstellungsdatum des Dokumentes.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="Version" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Die Version des Dokumentes.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="Letzte_Aenderung" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Letztes Änderungsdatum des Dokumentes.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="Zuletzt_bearbeitet_durch" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Name / Username des Nutzers, der das Dokument zuletzt bearbeitet hat.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Dokument_Info">
        <xs:annotation>
            <xs:documentation>
                Informationen zu der Datei eines Dokumentes und der mglw. dazu gehörigen Signaturen. 
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element maxOccurs="1" minOccurs="1" name="Dokument_Referenz" type="elna:Datei_Info">
                <xs:annotation>
                    <xs:documentation>
                        Referenz auf die Datei des Dokumentes selbst.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="unbounded" minOccurs="0" name="Signatur" type="elna:Datei_Info">
                <xs:annotation>
                    <xs:documentation>
                        Referenz auf die externe Signaturdatei eines Dokumentes.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Datei_Info">
        <xs:annotation>
            <xs:documentation>
                Referenz auf ein Dokument bzw. der sich darauf bezogenen Signaturprüfprotokoll.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element maxOccurs="1" minOccurs="1" name="Datei_Referenz" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Referenz auf einer Datei im Dateisystem als relative Pfadangabe. 
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="unbounded" minOccurs="0" name="Pruefprotokoll_Referenz"
                type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Referenz auf das zur Datei gehörige Prüfprotokoll. Bei embedded Signaturen ist die Datei das Dokument selbst. Bei detached Signaturen ist die Datei die externe Signaturdatei.
                    </xs:documentation>
                </xs:annotation>
