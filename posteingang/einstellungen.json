{
  "eingang": "Y:\\Posteingang",
  "ziel_urkunden": "Y:\\Posteingang\\Urkunden",
  "ziel_vorgaenge": "Y:\\Posteingang\\Vorgänge",
  "ziel_unklar": "Y:\\Posteingang\\Nicht zugeordnet",
  "archiv": "Y:\\Posteingang\\Original-Scans",
  "protokoll": "Y:\\Posteingang\\Protokoll",
  "ziel_dubletten": "Y:\\Posteingang\\Dubletten",
  "dubletten_schwelle": 0.95,
  "dubletten_tage": 30,
  "tageslisten": "Y:\\Posteingang\\Tageslisten",

  "nebenakte": {
    "export_ordner": "Y:\\Nebenakten-Export",
    "aufbewahrungsfrist": 7,
    "imprinter_seiten_je_blatt": 0,
    "vollzug_arten": ["Grundbuchamt", "Genehmigung", "Vorkaufsrecht", "Zustimmung Verwalter",
                      "Unbedenklichkeitsbescheinigung", "Bank / Löschung", "Register / Nachlass",
                      "Verwahrung / Anderkonto"],
    "papier_original_muster": ["Grundschuldbrief", "Hypothekenbrief", "L(ö|oe)schungsbewilligung",
                               "Genehmigungserkl(ä|ae)rung", "Verwalterzustimmung", "Vollmacht"]
  },

  "ordnername_urkunde": "{nr}-{jahr}",
  "ordnername_vorgang": "{nr}",
  "vorrang": "urkunde",

  "urkunden_archiv": "Y:\\Scanner\\URKUNDEN\\Urkunden {jahr}",
  "vorgaenge_ordner": ["Y:\\Vorgänge"],

  "intervall_sekunden": 20,
  "update_pruefen_minuten": 60,
  "warten_sekunden": 15,
  "schwelle_neues_schreiben": 3,

  "merkmale_an_uns_adressiert": [
    "Woinar",
    "Notariat\\s+Woinar",
    "Notar\\s+Thomas"
  ],

  "muster_uvz": [
    "\\b(?:UVZ|U\\.?\\s?R|Urk(?:\\.|unde(?:n(?:rolle)?)?)?)\\s*[.\\-]?\\s*[-.]?\\s*(?:Nr|Nummer)\\s*\\.?\\s*:?\\s*(?:W\\s?)?(?P<nr>[0-9OolI|SB]{1,5})(?:\\s*(?:/|-|für|fuer)\\s*(?P<jahr>[0-9OolI]{2,4}))?",
    "\\bUVZ\\s*[.:\\-]?\\s*(?P<nr>[0-9OolI|SB]{1,5})\\s*(?:/|-|für)\\s*(?P<jahr>[0-9OolI]{2,4})",
    "\\bUR\\s+(?P<nr>[0-9OolI|SB]{1,5})\\s*/\\s*(?P<jahr>[0-9OolI]{2,4})",
    "\\bW\\s?(?P<nr>[0-9OolI|SB]{1,5})\\s*[/-]\\s*(?P<jahr>[0-9OolI]{4})",
    "(?<![\\d/])(?:W\\s?)?(?P<nr>[0-9OolI|SB]{1,5})\\s*/\\s*\\d{1,2}\\s*/\\s*\\d{1,2}\\s*[-/]\\s*(?P<jahr>[0-9OolI]{4})",
    "\\bNr\\.?\\s*(?P<nr>[0-9OolI|SB]{1,5})\\s*/\\s*(?P<jahr>[0-9OolI]{2,4})\\s+(?:der|des|meiner|seiner)\\s+(?:Urkundenrolle|UR|UVZ|Urkundenverzeichnis)",
    "\\bW\\s?(?P<nr>[0-9OolI|SB]{1,5})\\s*[/-]\\s*(?P<jahr>[0-9OolI]{2})(?![/.\\d])"
  ],
  "muster_uvz_oben": [
    "(?<![A-Za-zÄÖÜäöü]\\s)(?<![\\w/.,:\\-])(?P<nr>[0-9OolI|SB]{1,5})\\s*/\\s*(?P<jahr>[2Z][0O][0-9OolI]{2})(?![/.\\d])"
  ],

  "standard_aktion": "vorlegen",
  "arten": [
      {
          "name": "Vorkaufsrecht",
          "aktion": "vorlegen",
          "muster": [
              "Vorkaufsrecht",
              "Negativattest",
              "Negativzeugnis"
          ]
      },
      {
          "name": "Genehmigung",
          "aktion": "vorlegen",
          "muster": [
              "Grundst(ü|ue)cksverkehrsgesetz",
              "GrdstVG",
              "Teilungsgenehmigung",
              "Sanierungs(rechtliche|genehmigung)",
              "(familien|betreuungs|nachlass)gerichtlich\\w* Genehmigung",
              "Genehmigungserkl(ä|ae)rung",
              "Nachgenehmigung",
              "genehmige\\b",
              "Genehmigung"
          ]
      },
      {
          "name": "Zustimmung Verwalter",
          "aktion": "vorlegen",
          "muster": [
              "Verwalterzustimmung",
              "Zustimmung (des|der) (WEG-)?Verwalt",
              "Zustimmungserkl(ä|ae)rung"
          ]
      },
      {
          "name": "Vollmacht / Erklärung",
          "aktion": "vorlegen",
          "muster": [
              "Vollmachtsbest(ä|ae)tigung",
              "unterschrieben\\w*\\s+(Vollmacht|Erkl(ä|ae)rung)",
              "Vollmacht",
              "beglaubigt"
          ]
      },
      {
          "name": "Grundbuchamt",
          "aktion": "vorlegen",
          "muster": [
              "Eintragungsnachricht",
              "Eintragungsmitteilung",
              "Vollzugsmitteilung",
              "Zwischenverf(ü|ue)gung",
              "Zur(ü|ue)ckweisung",
              "Beanstandung",
              "Grundbuchamt"
          ]
      },
      {
          "name": "Unbedenklichkeitsbescheinigung",
          "aktion": "vorlegen",
          "muster": [
              "Unbedenklichkeitsbescheinigung",
              "Grunderwerbsteuer"
          ]
      },
      {
          "name": "Bank / Löschung",
          "aktion": "vorlegen",
          "muster": [
              "L(ö|oe)schungsbewilligung",
              "L(ö|oe)schungsunterlagen",
              "Treuhandauf(trag|lage)",
              "Grundschuldbrief",
              "Hypothekenbrief",
              "Abl(ö|oe)se(betrag|summe|forderung)",
              "Pfandfreigabe"
          ]
      },
      {
          "name": "Register / Nachlass",
          "aktion": "vorlegen",
          "muster": [
              "Handelsregister",
              "Registergericht",
              "Vereinsregister",
              "Nachlassgericht",
              "Erbschein"
          ]
      },
      {
          "name": "Frist / Mahnung",
          "aktion": "vorlegen",
          "muster": [
              "Frist\\w*\\s+(bis|zum)",
              "Mahnung",
              "Erinnerung"
          ]
      },
      {
          "name": "Verwahrung / Anderkonto",
          "aktion": "vorlegen",
          "muster": [
              "Anderkonto",
              "Verwahrungs(gesch(ä|ae)ft|anweisung|vereinbarung)",
              "Hinterlegung"
          ]
      },
      {
          "name": "Zahlung / Bestätigung",
          "aktion": "ablegen",
          "muster": [
              "Zahlungseingang",
              "(Ü|Ue)berweisungsbest(ä|ae)tigung",
              "Eingangsbest(ä|ae)tigung",
              "Empfangsbest(ä|ae)tigung",
              "Terminbest(ä|ae)tigung",
              "zur Kenntnisnahme",
              "zu Ihrer Kenntnis"
          ]
      },
      {
          "name": "Werbung",
          "aktion": "ablegen",
          "muster": [
              "Newsletter",
              "Sonderangebot",
              "Sonderpreis",
              "Angebot f(ü|ue)r Ihre Kanzlei",
              "Abmelden"
          ]
      },
      {
          "name": "Behörde / Gericht / Bank",
          "aktion": "vorlegen",
          "bereich": "oben",
          "muster": [
              "Amtsgericht",
              "Landgericht",
              "Landkreis",
              "Stadtverwaltung",
              "Stadt\\s+\\w+",
              "Gemeinde",
              "Amt\\s+\\w+",
              "Finanzamt",
              "Sparkasse",
              "\\bBank\\b",
              "Volksbank",
              "Raiffeisenbank",
              "Vermessungs",
              "Kataster"
          ]
      }
  ],

  "muster_vorgang": [
    "\\b(?:Ihr(?:e)?\\s+(?:Zeichen|Z\\.|Az\\.?|Aktenzeichen|Vorgang)|Vorgang(?:s)?(?:\\s*-?\\s*Nr\\.?|nummer)?)\\s*[:.]?\\s*(?:Nr\\.?\\s*)?(?P<nr>[0-9OolI|SB]{5})(?!\\s*[/-]\\s*\\d)"
  ]
}
