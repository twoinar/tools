# Tools des Notariats auf dem IONOS-Server: https://tools.notariat-woinar.de/tools/ , /boegen/ , /kostenrechner/
# (gleiche Pfade wie bei GitHub Pages). Dieser Caddy läuft im eigenen Container ohne veröffentlichten Port;
# den Zugang von außen und das Zertifikat übernimmt der Caddy der Buchhaltung (twoinar/buchhaltung,
# deploy/synology/weitere/tools.caddy), der hierher weiterleitet.
# Werte aus /opt/tools/konfig/.env: TOOLS_BENUTZER, TOOLS_PASSWORT_HASH, ANTHROPIC_API_KEY, IONOS_TOKEN (dazu MAIL_*/GRAPH_* für tools-mail).
{
	admin localhost:2019
	auto_https off
}

:80 {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Login nur für das, was im Notariat bleibt: Thomas' eigene Bögen (/boegen/), Tools intern, das Claude-Fenster
	# (/tools/claude-starter/, /claude) und der Claude-Zugang (/api/). Ohne Login für die Kollegen: alle übrigen Tools
	# unter /tools/ (wie früher auf GitHub Pages) und der GNotKG-Kostenrechner. Die verschlüsselten Dateien von
	# Tools intern sind ebenfalls frei (ohne Passwort unlesbar); die holt auch das Claude-Fenster am PC
	# (http://localhost:8766), das den Login nicht mitschicken kann.
	@verschluesselt path /tools/intern/daten/* /tools/intern/schluessel.json
	header @verschluesselt Access-Control-Allow-Origin *
	#
	# Angemeldet bleiben (Wunsch Thomas 17.11.2026, sonst fragte z. B. der Vollzugsbogen nach dem Verteilerzettel
	# jedes Mal nach dem Passwort): Nach der Anmeldung setzt der Server das Cookie „tools_login“ (400 Tage, nur
	# über HTTPS, für Skripte der Seiten unlesbar). Wer es mitschickt, braucht kein Passwort mehr. Sein Wert ist
	# der Zufallsschlüssel TOOLS_COOKIE aus .env (legt aktualisieren.sh selbst an, neu bei --einrichten, dann
	# müssen sich alle Browser einmal neu anmelden). Ist der Schlüssel kürzer als 32 Zeichen oder fehlt er,
	# zählt das Cookie nicht: dann gilt wie bisher nur das Passwort. /abmelden löscht das Cookie in diesem Browser.
	@geschuetzt expression `(!path('/', '/tools', '/tools/*', '/kostenrechner', '/kostenrechner/*') || (path('/tools/intern', '/tools/intern/*', '/tools/claude-starter', '/tools/claude-starter/*') && !path('/tools/intern/daten/*', '/tools/intern/schluessel.json'))) && !(size({env.TOOLS_COOKIE}) >= 32 && {http.request.cookie.tools_login} == {env.TOOLS_COOKIE})`
	basic_auth @geschuetzt {
		{$TOOLS_BENUTZER} {$TOOLS_PASSWORT_HASH}
	}
	handle /abmelden {
		header Set-Cookie "tools_login=; Max-Age=0; Path=/; Secure; HttpOnly; SameSite=Lax"
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><meta charset=utf-8><title>Abgemeldet</title><p style='font:16px system-ui;margin:40px'>In diesem Browser abgemeldet. Beim nächsten Aufruf fragt der Server wieder nach dem Passwort.</p>"
	}

	# Claude: die Seiten rufen /api/claude/v1/messages auf. Der Schlüssel liegt nur hier auf dem Server
	# und wird beim Weiterleiten eingesetzt; Login-Daten und Cookies gehen nicht an Anthropic.
	handle /api/claude/v1/messages {
		uri strip_prefix /api/claude
		# Version und Beta-Funktionen bestimmt die Seite; fehlt die Version, gilt diese
		@ohneVersion not header Anthropic-Version *
		request_header @ohneVersion Anthropic-Version 2023-06-01
		request_body {
			max_size 30MB
		}
		reverse_proxy https://api.anthropic.com {
			header_up Host api.anthropic.com
			header_up -Authorization
			header_up -Cookie
			header_up -Origin
			header_up -Referer
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -Via
			header_up -Anthropic-Dangerous-Direct-Browser-Access
			header_up X-Api-Key {$ANTHROPIC_API_KEY}
		}
	}
	# KI bei IONOS Cloud (AI Model Hub, Rechenzentrum in Deutschland, OpenAI-kompatibel): die Seiten rufen
	# /api/ionos/v1/chat/completions bzw. /api/ionos/v1/models auf, der Token liegt nur hier auf dem Server.
	# Nur diese beiden Pfade; Login-Daten und Cookies gehen nicht an IONOS.
	handle /api/ionos/v1/* {
		# (nach uri strip_prefix geprüft, daher ohne /api/ionos)
		@nichtErlaubt not path /v1/chat/completions /v1/models
		respond @nichtErlaubt 404
		uri strip_prefix /api/ionos
		request_body {
			max_size 30MB
		}
		reverse_proxy https://openai.inference.de-txl.ionos.com {
			header_up Host openai.inference.de-txl.ionos.com
			header_up -Cookie
			header_up -Origin
			header_up -Referer
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -Via
			header_up Authorization "Bearer {$IONOS_TOKEN}"
			transport http {
				response_header_timeout 300s
			}
		}
	}
	# Benachrichtigung „Vorgespräch abgelegt“ an das Sekretariat (Container tools-mail, Empfänger fest auf dem Server)
	handle /api/mail/ablage {
		request_body {
			max_size 4KB
		}
		reverse_proxy tools-mail:8080
	}
	# Registerabruf (handelsregister.de) für das Claude-Fenster im Browser (Container tools-register)
	# Vollzugsbogen direkt per Mail an Mitarbeiter (nur @notar-woinar.de, prüft tools-mail) und ob das eingerichtet ist
	handle /api/mail/vollzug {
		request_body {
			max_size 6MB
		}
		reverse_proxy tools-mail:8080
	}
	handle /api/mail/status {
		reverse_proxy tools-mail:8080
	}
	handle /api/hr/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy tools-register:8081 {
			transport http {
				response_header_timeout 120s
			}
		}
	}
	handle /api/* {
		respond 404
	}

	redir / /tools/ 302
	# Kurze Adresse für das Claude-Fenster
	redir /claude /tools/claude-starter/web/claude.html 302
	redir /claude/ /tools/claude-starter/web/claude.html 302
	handle {
		# Cookie „tools_login“ setzen: steht bewusst hier drin, denn basic_auth (oben) läuft vor jedem handle –
		# die Zeile wird also nur erreicht, wenn das Passwort stimmte, und nie in einer 401-Antwort.
		header @geschuetzt Set-Cookie "tools_login={env.TOOLS_COOKIE}; Max-Age=34560000; Path=/; Secure; HttpOnly; SameSite=Lax"
		root * /srv/web
		file_server
	}
}
