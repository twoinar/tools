# Tools des Notariats auf dem IONOS-Server: https://tools.notariat-woinar.de/tools/ , /boegen/ , /kostenrechner/
# (gleiche Pfade wie bei GitHub Pages). Dieser Caddy läuft im eigenen Container ohne veröffentlichten Port;
# den Zugang von außen und das Zertifikat übernimmt der Caddy der Buchhaltung (twoinar/buchhaltung,
# deploy/synology/weitere/tools.caddy), der hierher weiterleitet.
# Werte aus /opt/tools/konfig/.env: TOOLS_BENUTZER, TOOLS_PASSWORT_HASH, ANTHROPIC_API_KEY.
{
	admin localhost:2019
	auto_https off
}

:80 {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Ein Login für alle Seiten und für Claude. Ausgenommen sind
	# - die verschlüsselten Dateien von Tools intern (ohne Passwort unlesbar, lagen vorher öffentlich auf GitHub Pages):
	#   die holt auch das Claude-Fenster am PC (http://localhost:8766), das den Login nicht mitschicken kann;
	# - die öffentlichen Muster für Kollegen: die Bögen-Kopie /tools/boegen/ und der GNotKG-Kostenrechner, den diese
	#   Bögen einbinden (beide ohne Daten des Notariats; die Notardaten bleiben im Browser des Kollegen).
	@verschluesselt path /tools/intern/daten/* /tools/intern/schluessel.json
	header @verschluesselt Access-Control-Allow-Origin *
	@geschuetzt not path /tools/intern/daten/* /tools/intern/schluessel.json /tools/boegen /tools/boegen/* /kostenrechner /kostenrechner/*
	basic_auth @geschuetzt {
		{$TOOLS_BENUTZER} {$TOOLS_PASSWORT_HASH}
	}

	# Claude: die Seiten rufen /api/claude/v1/messages auf. Der Schlüssel liegt nur hier auf dem Server
	# und wird beim Weiterleiten eingesetzt; Login-Daten und Cookies gehen nicht an Anthropic.
	handle /api/claude/v1/messages {
		uri strip_prefix /api/claude
		# Version und Beta-Funktionen bestimmt die Seite; fehlt die Version, gilt diese
		@ohneVersion not header Anthropic-Version *
		request_header @ohneVersion Anthropic-Version 2023-06-01
		request_body {
			max_size 30MB
		}
		reverse_proxy https://api.anthropic.com {
			header_up Host api.anthropic.com
			header_up -Authorization
			header_up -Cookie
			header_up -Origin
			header_up -Referer
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -Via
			header_up -Anthropic-Dangerous-Direct-Browser-Access
			header_up X-Api-Key {$ANTHROPIC_API_KEY}
		}
	}
	handle /api/* {
		respond 404
	}

	redir / /tools/ 302
	# Kurze Adresse für das Claude-Fenster
	redir /claude /tools/claude-starter/web/claude.html 302
	redir /claude/ /tools/claude-starter/web/claude.html 302
	handle {
		root * /srv/web
		file_server
	}
}
